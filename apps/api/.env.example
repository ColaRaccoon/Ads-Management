DATABASE_URL="postgresql://meta_ads_app:<PASSWORD>@localhost:5432/meta_ads_performance?schema=public"
PRISMA_CONNECTION_LIMIT=1
PORT=4100
STORAGE_PROVIDER="local"
UPLOAD_STORAGE_DIR="./storage/uploads"
REPORT_STORAGE_DIR="./storage/reports"
# Set STORAGE_PROVIDER=supabase only for an approved private Supabase bucket.
# Keep these values server-only; never copy them to NEXT_PUBLIC variables.
SUPABASE_STORAGE_BUCKET=""
SUPABASE_STORAGE_RETENTION_DAYS=30
SUPABASE_STORAGE_TIMEOUT_MS=15000
SUPABASE_STORAGE_MAX_OBJECT_BYTES=52428800
TEMP_STORAGE_BUDGET_BYTES=104857600
REPORT_DOWNLOAD_MAX_LIFETIME_MS=300000
# Production requires rls plus a dedicated, short-lived Storage JWT. The Auth
# admin key remains reserved for Auth administration and development verification.
SUPABASE_STORAGE_ACCESS_MODE="admin"
SUPABASE_STORAGE_ACCESS_TOKEN=""
SUPABASE_STORAGE_MIN_TOKEN_TTL_SECONDS=86400
SUPABASE_STORAGE_MAX_TOKEN_TTL_SECONDS=604800
SUPABASE_STORAGE_TOKEN_SUBJECT=""
SUPABASE_STORAGE_READINESS_KEY=""
KOREA_EXIM_API_KEY=""
EXCHANGE_RATE_PROVIDER="KOREA_EXIM"
EXCHANGE_RATE_LOOKBACK_DAYS=10

# Supabase Auth is used only by the API. Never expose the secret key to Web.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_AUDIENCE="authenticated"

# Use separate random secrets of at least 32 bytes. Do not reuse provider keys.
AUTH_SESSION_HANDLE_SECRET=""
AUTH_SESSION_HANDLE_PREVIOUS_SECRET=""
AUTH_AUTHORIZATION_VERSION_SECRET=""
AUTH_CSRF_SECRET=""
AUTH_CSRF_PREVIOUS_SECRET=""
# Signed browser CSRF token lifetime (5 minutes through 24 hours).
AUTH_CSRF_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAMESPACE=""
APP_ENV="development"
APP_ALLOWED_ORIGINS="http://127.0.0.1:3200,http://localhost:3200"

# Number of reverse-proxy hops trusted by Express (0-3; never use an unbounded value).
TRUST_PROXY_HOPS=0
# Independent high-entropy token injected only by an internal readiness probe.
INTERNAL_PROBE_TOKEN=""
READINESS_TIMEOUT_MS=1500
DATABASE_READINESS_TIMEOUT_MS=1000
JSON_BODY_LIMIT_BYTES=262144
URLENCODED_BODY_LIMIT_BYTES=65536

# Non-secret deployment identities are folded into the startup fingerprint.
DEPLOYMENT_ENVIRONMENT_ID=""
RUNTIME_API_TARGET_ID=""
RUNTIME_DATABASE_ID=""
RUNTIME_STORAGE_ID=""
