{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/api-build.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist"
  },
  "watchOptions": {
    "excludeDirectories": ["dist", "node_modules", "storage"]
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/auth/bootstrap-super-admin.cli.ts",
    "src/**/*.cli.ts",
    "dist",
    "node_modules",
    "prisma/**/*.ts"
  ]
}
