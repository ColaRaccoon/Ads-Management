{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-ads-performance.invalid/contracts/migration-target-plan.v1.schema.json",
  "title": "Redacted migration inspection plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "planId", "releaseId", "targetSha256", "projectRef", "releaseGitSha", "mode",
    "classification", "applyRequired", "counts", "digests", "codes"
  ],
  "properties": {
    "version": { "const": "migration-target-plan/v1" },
    "planId": { "$ref": "#/$defs/sha256" },
    "releaseId": { "$ref": "#/$defs/sha256" },
    "targetSha256": { "$ref": "#/$defs/sha256" },
    "projectRef": { "type": "string", "pattern": "^[a-z]{20}$" },
    "releaseGitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "mode": { "const": "INSPECT_ONLY" },
    "classification": {
      "enum": [
        "PRISTINE_EMPTY_SCHEMA_READY", "MANAGED_EXACT_CHAIN_READY",
        "LEGACY_COLLISION_BLOCKED", "PARTIAL_OR_DRIFT_BLOCKED"
      ]
    },
    "applyRequired": { "type": "boolean" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relations", "types", "legacyOverlap", "applied", "pending", "failedOrRolledBack",
        "unknownHistory", "unexpectedRelations"
      ],
      "properties": {
        "relations": { "$ref": "#/$defs/count" },
        "types": { "$ref": "#/$defs/count" },
        "legacyOverlap": { "$ref": "#/$defs/count" },
        "applied": { "$ref": "#/$defs/count" },
        "pending": { "$ref": "#/$defs/count" },
        "failedOrRolledBack": { "$ref": "#/$defs/count" },
        "unknownHistory": { "$ref": "#/$defs/count" },
        "unexpectedRelations": { "$ref": "#/$defs/count" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogSha256", "legacyOverlapSha256", "connectionSha256"],
      "properties": {
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "legacyOverlapSha256": { "$ref": "#/$defs/sha256" },
        "connectionSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
