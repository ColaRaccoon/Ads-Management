{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-provider-binding.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "projectRef", "releaseGitSha", "targetSha256", "database", "supabaseOrigin", "bucket",
    "bucketVisibility", "storageTokenScope", "storageTokenSha256", "approvedSourceRoots",
    "sourceInventoryApprovalSha256", "referenceInventoryDigestSha256", "executionPlanDigestSha256",
    "issuedAt", "expiresAt", "providerBindingSha256"
  ],
  "properties": {
    "version": { "const": "legacy-provider-binding/v1" },
    "projectRef": { "type": "string", "pattern": "^[a-z]{20}$" },
    "releaseGitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "targetSha256": { "$ref": "#/$defs/sha256" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionMode", "host", "port", "name", "schema", "loginUser", "expectedCurrentUser",
        "requiredRole", "sslMode", "tlsServerName"
      ],
      "properties": {
        "connectionMode": { "enum": ["direct", "session_pooler"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "const": 5432 },
        "name": { "type": "string", "minLength": 1, "maxLength": 63 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
        "loginUser": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expectedCurrentUser": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requiredRole": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sslMode": { "const": "verify-full" },
        "tlsServerName": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "supabaseOrigin": { "type": "string", "pattern": "^https://[a-z]{20}\\.supabase\\.co$" },
    "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
    "bucketVisibility": { "const": "private" },
    "storageTokenScope": { "const": "LEGACY_PRIVATE_OBJECT_READ_WRITE_NO_DELETE" },
    "storageTokenSha256": { "$ref": "#/$defs/sha256" },
    "approvedSourceRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rootId", "rootPath"],
        "properties": {
          "rootId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
          "rootPath": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "sourceInventoryApprovalSha256": { "$ref": "#/$defs/sha256" },
    "referenceInventoryDigestSha256": { "$ref": "#/$defs/sha256" },
    "executionPlanDigestSha256": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "providerBindingSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
