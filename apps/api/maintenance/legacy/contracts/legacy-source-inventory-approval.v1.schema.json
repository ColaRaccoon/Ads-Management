{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-source-inventory-approval.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "projectRef", "releaseGitSha", "targetSha256", "referenceInventoryDigestSha256",
    "executionPlanDigestSha256", "driftDisposition", "issuedAt", "expiresAt", "roots", "approvalSha256"
  ],
  "properties": {
    "version": { "const": "legacy-source-inventory-approval/v1" },
    "projectRef": { "type": "string", "pattern": "^[a-z]{20}$" },
    "releaseGitSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "targetSha256": { "$ref": "#/$defs/sha256" },
    "referenceInventoryDigestSha256": { "$ref": "#/$defs/sha256" },
    "executionPlanDigestSha256": { "$ref": "#/$defs/sha256" },
    "driftDisposition": { "const": "APPROVED_CURRENT_INVENTORY" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rootId", "rootPath", "fileCount", "totalBytes", "manifestSha256"],
        "properties": {
          "rootId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
          "rootPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "fileCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "totalBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "manifestSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "approvalSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
