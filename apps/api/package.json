{
  "name": "@meta-ads-performance/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev-watch.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start:watch": "node scripts/dev-watch.mjs",
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment node",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "auth:bootstrap-local-super-admin": "node --import tsx src/auth/bootstrap-local-super-admin.cli.ts",
    "files:measure-metadata": "node --import tsx src/file-security/upload-metadata-measurement.cli.ts",
    "storage:purge": "node --env-file=.env --import tsx src/storage/storage-retention.cli.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "6.12.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "4.4.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "jose": "^5.10.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "prisma": "6.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
