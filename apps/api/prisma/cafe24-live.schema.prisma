  @@map("sync_leases")
}

model SourceCoverage {
  connectionId        String              @map("connection_id") @db.Uuid
  dataKind            SourceDataKind      @map("data_kind")
  metricDate          DateTime            @map("metric_date") @db.Date
  source              SourceKind
  state               SourceCoverageState @default(NOT_COLLECTED)
  lastAttemptRunId    String?             @map("last_attempt_run_id") @db.Uuid
  lastSuccessRunId    String?             @map("last_success_run_id") @db.Uuid
  lastSuccessAt       DateTime?           @map("last_success_at") @db.Timestamptz(3)
  lastAttemptAt       DateTime?           @map("last_attempt_at") @db.Timestamptz(3)
  rowCount            Int?                @map("row_count")
  totalAmount         Decimal?            @map("total_amount") @db.Decimal(24, 6)
  reconciliationStatus String?            @map("reconciliation_status") @db.VarChar(64)
  warningCodes        String[]            @default([]) @map("warning_codes")
  connection          SourceConnection    @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  lastAttemptRun      SyncRun?             @relation("CoverageAttempt", fields: [lastAttemptRunId], references: [id], onDelete: Restrict)
  lastSuccessRun      SyncRun?             @relation("CoverageSuccess", fields: [lastSuccessRunId], references: [id], onDelete: Restrict)

  @@id([connectionId, dataKind, metricDate])
  @@index([metricDate, state])
  @@map("source_coverage")
}

model SourceRecordLink {
  id               String              @id @default(uuid()) @db.Uuid
  connectionId     String              @map("connection_id") @db.Uuid
  dataKind         SourceDataKind      @map("data_kind")
  canonicalKeyHash String              @map("canonical_key_hash") @db.Char(64)
  source           SourceKind
  recordTable      String              @map("record_table") @db.VarChar(64)
  recordId         String              @map("record_id") @db.Uuid
  syncRunId        String?             @map("sync_run_id") @db.Uuid
  version          Int
  isCurrent        Boolean             @default(true) @map("is_current")
  boundAt          DateTime            @default(now()) @map("bound_at") @db.Timestamptz(3)
  bindingMethod    SourceBindingMethod @map("binding_method")
  connection       SourceConnection    @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  syncRun          SyncRun?            @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([connectionId, dataKind, source, recordTable, recordId])
  @@index([connectionId, dataKind, canonicalKeyHash, isCurrent])
  @@map("source_record_links")
}

model Cafe24OrderApiVersion {
  id                  String           @id @default(uuid()) @db.Uuid
  connectionId        String           @map("connection_id") @db.Uuid
  canonicalKeyHash    String           @map("canonical_key_hash") @db.Char(64)
  orderNo             String           @map("order_no") @db.VarChar(256)
  lineOrderNo         String           @map("line_order_no") @db.VarChar(256)
  productNo           String           @map("product_no") @db.VarChar(256)
  optionName          String           @map("option_name") @db.VarChar(514)
  orderedAt           DateTime         @map("ordered_at") @db.Timestamptz(3)
  orderDate           DateTime         @map("order_date") @db.Date
  providerUpdatedAt   DateTime?        @map("provider_updated_at") @db.Timestamptz(3)
  fetchedAt           DateTime?        @map("fetched_at") @db.Timestamptz(3)
  contentFingerprint  String?          @map("content_fingerprint") @db.Char(64)
  fingerprintKeyVersion Int?           @map("fingerprint_key_version")
  quantity            Decimal          @db.Decimal(14, 4)
  salePriceKrw        Decimal          @map("sale_price_krw") @db.Decimal(18, 2)
  totalOrderKrw       Decimal?         @map("total_order_krw") @db.Decimal(18, 2)
  totalPaidKrw        Decimal          @map("total_paid_krw") @db.Decimal(18, 2)
  totalPaidInputSource String?          @map("total_paid_input_source") @db.VarChar(64)
  paymentMethod       String?          @map("payment_method") @db.VarChar(256)
  providerPaymentCodes Json?           @map("provider_payment_codes")
  providerCouponSignal Boolean?        @map("provider_coupon_signal")
  actualOrderPriceKrw Decimal?         @map("actual_order_price_krw") @db.Decimal(18, 2)
  actualPaymentKrw    Decimal?         @map("actual_payment_krw") @db.Decimal(18, 2)
  actualShippingFeeKrw Decimal?        @map("actual_shipping_fee_krw") @db.Decimal(18, 2)
  initialOrderPriceKrw Decimal?        @map("initial_order_price_krw") @db.Decimal(18, 2)
  initialPaymentKrw   Decimal?         @map("initial_payment_krw") @db.Decimal(18, 2)
  initialShippingFeeKrw Decimal?       @map("initial_shipping_fee_krw") @db.Decimal(18, 2)
  orderStatus         String?          @map("order_status") @db.VarChar(64)
  lineStatus          String?          @map("line_status") @db.VarChar(64)
  cancelledAt         DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelAmountKrw     Decimal?         @map("cancel_amount_krw") @db.Decimal(18, 2)
  refundedAt          DateTime?        @map("refunded_at") @db.Timestamptz(3)
  refundAmountKrw     Decimal?         @map("refund_amount_krw") @db.Decimal(18, 2)
  discountAmountKrw   Decimal?         @map("discount_amount_krw") @db.Decimal(18, 2)
  couponAmountKrw     Decimal?         @map("coupon_amount_krw") @db.Decimal(18, 2)
  version             Int
  isCurrent           Boolean          @default(true) @map("is_current")
  syncRunId           String           @map("sync_run_id") @db.Uuid
  connection          SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  syncRun             SyncRun          @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([connectionId, canonicalKeyHash, version])
  @@index([connectionId, orderDate])
  @@map("cafe24_order_api_versions")
}

model SourceCredential {
  id             String           @id @default(uuid()) @db.Uuid
  connectionId   String           @map("connection_id") @db.Uuid
  kind           String           @db.VarChar(32)
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes            @map("auth_tag")
  keyVersion     Int              @map("key_version")
  revision       Int              @default(1)
  refreshOwner   String?          @map("refresh_owner") @db.Uuid
  refreshUntil   DateTime?        @map("refresh_until") @db.Timestamptz(3)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection     SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, kind])
  @@map("source_credentials")
}
