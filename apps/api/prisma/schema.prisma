  cafe24ObservedRevisions Cafe24ObservedOrderRevision[]
  cafe24ObservedDays  Cafe24ObservedDayCheckpoint[]
  cafe24ObservedEpochRevisions Cafe24ObservedEpochOrderRevision[]
  cafe24ObservedEpochDays Cafe24ObservedEpochDayCheckpoint[]

  @@unique([provider, externalAccountId, shopKey])
  @@map("source_connections")
}

// Only a digest of the one-time OAuth state is persisted. No code or token enters this table.
