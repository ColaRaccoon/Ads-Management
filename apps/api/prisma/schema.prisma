  provider            SourceProvider
  externalAccountId   String            @map("external_account_id") @db.VarChar(256)
  shopKey             String            @default("default") @map("shop_key") @db.VarChar(256)
  displayName         String            @map("display_name") @db.VarChar(256)
  currencyCode        String            @map("currency_code") @db.VarChar(3)
  timeZone            String            @map("time_zone") @db.VarChar(128)
  credentialRef       String?           @map("credential_ref") @db.VarChar(256)
  credentialExpiresAt DateTime?         @map("credential_expires_at") @db.Timestamptz(3)
  accessState         SourceAccessState @default(PENDING) @map("access_state")
  enabled             Boolean           @default(false)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  policies            SourcePolicy[]
  runs                SyncRun[]
  lease               SyncLease?
  coverage            SourceCoverage[]
  googleCosts         GoogleCampaignDailyCost[]
  recordLinks         SourceRecordLink[]
  creativePlacements  CreativePlacement[]
  cafe24Versions      Cafe24OrderApiVersion[]
