// Separate observation epochs never reinterpret or overwrite the quarantined V1 tables.
model Cafe24ObservedEpochOrderRevision {
  connectionId String @map("connection_id") @db.Uuid
  keyVersion Int @map("key_version")
  epochReference String @map("epoch_reference") @db.Uuid
  epochStartedAt DateTime @map("epoch_started_at") @db.Timestamptz(3)
  keyCommitment String @map("key_commitment") @db.Char(64)
  keyIdentityCommitment String @map("key_identity_commitment") @db.Char(64)
  baselineApprovalSha256 String @map("baseline_approval_sha256") @db.Char(64)
  sourceClosureSha256 String @map("source_closure_sha256") @db.Char(64)
  orderKeyHash String @map("order_key_hash") @db.Char(64)
  revision Int
  orderDate DateTime @map("order_date") @db.Date
  contentHash String @map("content_hash") @db.Char(64)
  firstObservedAt DateTime @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt DateTime @map("last_observed_at") @db.Timestamptz(3)
  observationId String @map("observation_id") @db.Uuid
  isCurrent Boolean @default(true) @map("is_current")
  integrityHash String @map("integrity_hash") @db.Char(64)
  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  checkpoint Cafe24ObservedEpochDayCheckpoint @relation(fields: [connectionId, keyVersion, orderDate], references: [connectionId, keyVersion, orderDate], onDelete: Restrict, map: "cafe24_epoch_revisions_checkpoint_fkey")

  @@id([connectionId, keyVersion, orderKeyHash, revision], map: "cafe24_epoch_revisions_pkey")
  @@index([connectionId, keyVersion, epochReference, orderDate, isCurrent], map: "cafe24_epoch_revisions_day_idx")
  @@map("cafe24_observed_epoch_order_revisions")
}

model Cafe24ObservedEpochDayCheckpoint {
  connectionId String @map("connection_id") @db.Uuid
  keyVersion Int @map("key_version")
  epochReference String @map("epoch_reference") @db.Uuid
  epochStartedAt DateTime @map("epoch_started_at") @db.Timestamptz(3)
  keyCommitment String @map("key_commitment") @db.Char(64)
  keyIdentityCommitment String @map("key_identity_commitment") @db.Char(64)
  baselineApprovalSha256 String @map("baseline_approval_sha256") @db.Char(64)
  sourceClosureSha256 String @map("source_closure_sha256") @db.Char(64)
  orderDate DateTime @map("order_date") @db.Date
  queryStartedAt DateTime @map("query_started_at") @db.Timestamptz(3)
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)
  observationId String @map("observation_id") @db.Uuid
  checkpointRevision Int @map("checkpoint_revision")
  orderCount Int @map("order_count")
  itemCount Int @map("item_count")
  snapshotHash String @map("snapshot_hash") @db.Char(64)
  integrityHash String @map("integrity_hash") @db.Char(64)
  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  revisions Cafe24ObservedEpochOrderRevision[]

  @@id([connectionId, keyVersion, orderDate], map: "cafe24_epoch_days_pkey")
  @@index([connectionId, keyVersion, epochReference], map: "cafe24_epoch_days_scope_idx")
  @@map("cafe24_observed_epoch_day_checkpoints")
}

