generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UploadStatus {
  PENDING
  VALIDATING
  VALIDATED
  IMPORTED
  PARTIAL
  FAILED
  CANCELLED

  @@map("upload_status")
}

enum UploadLevel {
  ADSET
  AD
  CAMPAIGN

  @@map("upload_level")
}

enum ConflictPolicy {
  SKIP
  OVERWRITE
  NEW_VERSION

  @@map("conflict_policy")
}

enum CoupangUploadSourceType {
  SALES
  ADS
  MARGIN
  PRICE_TEXT
  PROMOTION
  BUNDLE

  @@map("coupang_upload_source_type")
}

enum RowValidationStatus {
  VALID
  WARNING
  ERROR
  UNMATCHED

  @@map("row_validation_status")
}

enum MatchType {
  CONTAINS
  EXACT
  REGEX
  MANUAL

  @@map("match_type")
}

enum MatchSource {
  RULE
  MANUAL
  INFERRED
  UNMATCHED

  @@map("match_source")
}

enum AdStage {
  SC
  CBO
  ASC
  UNKNOWN

  @@map("ad_stage")
}

enum DecisionType {
  SCALE
  KEEP
  WATCH
  STOP_CANDIDATE
  SC_TO_CBO
  CBO_TO_ASC
  SC_TO_ASC
  ASC_TO_SC
  PROFIT
  LOSS

  @@map("decision_type")
}

enum ReportType {
  DAILY_HTML
  PERIOD_XLSX
  CHANGE_LOG_XLSX
  CPA_RULE_XLSX

  @@map("report_type")
}

enum ExchangeRateFallbackType {
  EXACT
  PREVIOUS_AVAILABLE
  LATEST_AVAILABLE
  MANUAL

  @@map("exchange_rate_fallback_type")
}

enum CreativeParseStatus {
  PARSED
  FALLBACK

  @@map("creative_parse_status")
}

enum CreativeLogActionType {
  NOTE
  TURN_ON
  TURN_OFF
  KEEP
  WATCH
  SCALE
  REDUCE
  CREATIVE_TEST
  CREATIVE_EXCLUDE
  OTHER

  @@map("creative_log_action_type")
}

enum Cafe24CouponScope {
  GLOBAL
  PRODUCT

  @@map("cafe24_coupon_scope")
}

enum AppRole {
  SUPER_ADMIN
  ADMIN
  USER
  GUEST

  @@map("app_role")
}

enum InviteStatus {
  PENDING_PROVIDER
  INVITED
  VERIFIED_PENDING_PASSWORD
  ACTIVE
  RECONCILE_REQUIRED
  CANCELLED

  @@map("invite_status")
}

enum SecurityAuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("security_audit_actor_type")
}

enum SecurityAuditResult {
  REQUESTED
  PROVIDER_SUCCEEDED
  SUCCESS
  FAILURE
  PARTIAL

  @@map("security_audit_result")
}

enum StorageTombstoneDomain {
  META_UPLOAD
  REPORT

  @@map("storage_tombstone_domain")
}

enum StorageTombstoneState {
  PENDING
  RETAINED
  RESTORED
  PURGED
  FAILED

  @@map("storage_tombstone_state")
}

enum SourceProvider {
  GOOGLE
  META
  CAFE24
}

enum SourceDataKind {
  GOOGLE_CAMPAIGN
  META_AD
  META_ADSET
  CAFE24_ORDER
}

enum SourceKind {
  CSV
  API
}

enum SourceAccessState {
  PENDING
  READY
  REAUTH_REQUIRED
  BLOCKED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  BACKFILL
  RETRY
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  ACTION_REQUIRED
  CANCELLED
}

enum RunUnitStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ACTION_REQUIRED
}

enum SourceCoverageState {
  NOT_CONNECTED
  NOT_COLLECTED
  RUNNING
  COMPLETE_ZERO
  COMPLETE_NONZERO
  PARTIAL
  FAILED
  STALE
  UNSUPPORTED
}

enum SourceBindingMethod {
  EXACT_ID
  REVIEWED_LEGACY
}

model AppUser {
  id              String           @id @default(uuid()) @db.Uuid
  username        String?          @unique @db.VarChar(64)
  normalizedUsername String?       @unique @map("normalized_username") @db.VarChar(64)
  email           String?          @unique
  normalizedEmail String?          @unique @map("normalized_email")
  name            String
  role            AppRole          @default(GUEST)
  inviteStatus    InviteStatus     @default(PENDING_PROVIDER) @map("invite_status")
  authUserId      String?          @unique @map("auth_user_id") @db.Uuid
  isActive        Boolean          @default(true) @map("is_active")
  lastLoginAt     DateTime?        @map("last_login_at")
  deactivatedAt   DateTime?        @map("deactivated_at")
  authzVersion    Int              @default(1) @map("authz_version")
  invitedAt       DateTime?        @map("invited_at")
  invitedBy       String?          @map("invited_by") @db.Uuid
  invitationRequestId String?      @unique @map("invitation_request_id") @db.Uuid
  invitationErrorCode String?      @map("invitation_error_code") @db.VarChar(64)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  authSessions    AppAuthSession[]
  sourcePoliciesChanged SourcePolicy[] @relation("SourcePolicyChanger")
  syncRunsStarted SyncRun[] @relation("SyncRunActor")
  localCredential LocalCredential?
  localSetupTokens LocalAccountSetupToken[] @relation("LocalSetupTokenSubject")
  localSetupTokensCreated LocalAccountSetupToken[] @relation("LocalSetupTokenCreator")
  creativeChangeLogs CreativeChangeLog[]  @relation("CreativeChangeLogCreator")
  productChangeLogs  ProductChangeLog[]   @relation("ProductChangeLogCreator")
  productMatchRules  ProductMatchRule[]   @relation("ProductMatchRuleCreator")
  adsetProductHistories AdsetProductHistory[] @relation("AdsetProductHistoryCreator")
  adsetStageHistories   AdsetStageHistory[]   @relation("AdsetStageHistoryCreator")
  metaUploadBatches    UploadBatch[]       @relation("MetaUploadBatchUploader")
  cafe24UploadBatches  Cafe24UploadBatch[] @relation("Cafe24UploadBatchUploader")
  coupangUploadBatches CoupangUploadBatch[] @relation("CoupangUploadBatchUploader")
  decisionRuns         DecisionRun[]       @relation("DecisionRunCreator")
  decisionLogs         DecisionLog[]       @relation("DecisionLogCreator")
  changeLogs           ChangeLog[]         @relation("ChangeLogCreator")
  reportExports        ReportExport[]      @relation("ReportExportCreator")
  updatedSettings      AppSetting[]         @relation("AppSettingUpdater")
  invitedByUser        AppUser?             @relation("AppUserInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  invitedUsers         AppUser[]            @relation("AppUserInviter")
  securityAuditEvents  SecurityAuditEvent[] @relation("SecurityAuditActor")
  storageTombstones    StorageTombstone[]    @relation("StorageTombstoneActor")

  @@index([invitedBy])
  @@index([inviteStatus, createdAt])
  @@map("app_users")
}

model AppAuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  appUserId         String    @map("app_user_id") @db.Uuid
  providerSessionId String?   @unique @map("provider_session_id")
  localTokenHash    String?   @unique @map("local_token_hash") @db.Char(64)
  previousLocalTokenHash String? @map("previous_local_token_hash") @db.Char(64)
  previousTokenValidUntil DateTime? @map("previous_token_valid_until") @db.Timestamptz(3)
  idleExpiresAt     DateTime? @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz(3)
  onboardingOnly    Boolean   @default(false) @map("onboarding_only")
  revokedAt         DateTime? @map("revoked_at")
  lastSeenAt        DateTime? @map("last_seen_at")
  refreshedAt       DateTime? @map("refreshed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  appUser           AppUser   @relation(fields: [appUserId], references: [id], onDelete: Restrict)

  @@index([appUserId, revokedAt])
  @@index([previousLocalTokenHash, previousTokenValidUntil])
  @@map("app_auth_sessions")
}

model LocalCredential {
  appUserId       String   @id @map("app_user_id") @db.Uuid
  algorithm       String   @default("scrypt") @db.VarChar(16)
  version         Int      @default(1)
  costN           Int      @map("cost_n")
  blockSizeR      Int      @map("block_size_r")
  parallelizationP Int     @map("parallelization_p")
  keyLength       Int      @map("key_length")
  salt            String   @db.VarChar(128)
  passwordHash    String   @map("password_hash") @db.VarChar(256)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  appUser         AppUser  @relation(fields: [appUserId], references: [id], onDelete: Restrict)

  @@map("local_credentials")
}

model LocalAccountSetupToken {
  id          String    @id @default(uuid()) @db.Uuid
  appUserId   String    @map("app_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  appUser     AppUser   @relation("LocalSetupTokenSubject", fields: [appUserId], references: [id], onDelete: Restrict)
  creator     AppUser?  @relation("LocalSetupTokenCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([appUserId, expiresAt])
  @@index([createdBy])
  @@map("local_account_setup_tokens")
}

model SecurityRateLimitBucket {
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  windowMs    Int      @map("window_ms")
  count       Int      @default(1)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([keyHash, windowStart, windowMs])
  @@index([expiresAt])
  @@map("security_rate_limit_buckets")
}

model LocalEdgeRequestNonce {
  nonceHash String   @id @map("nonce_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("local_edge_request_nonces")
}

model SecurityAuditEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  actorUserId String?                @map("actor_user_id") @db.Uuid
  actorType   SecurityAuditActorType @map("actor_type")
  action      String                 @db.VarChar(96)
  targetType  String                 @map("target_type") @db.VarChar(64)
  targetId    String?                @map("target_id") @db.VarChar(128)
  result      SecurityAuditResult
  beforeJson  Json?                  @map("before_json")
  afterJson   Json?                  @map("after_json")
  requestId   String?                @map("request_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  actor       AppUser?               @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@map("security_audit_events")
}

model Product {
  id              String                    @id @default(uuid()) @db.Uuid
  code            String                    @unique
  name            String
  displayName     String                    @map("display_name")
  sku             String?
  sortOrder       Int                       @default(100) @map("sort_order")
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  costRules       ProductCostRule[]
  cpaRules        ProductCpaRule[]
  matchRules      ProductMatchRule[]
  adsetHistories  AdsetProductHistory[]
  uploadRows      UploadRow[]
  dailyMetrics    MetaAdsetDailyMetric[]
  adDailyMetrics  MetaAdDailyMetric[]
  decisionLogs    DecisionLog[]
  changeLogs      ChangeLog[]
  productChangeLogs ProductChangeLog[]
  cafe24OrderLines Cafe24OrderLine[]
  cafe24ProductRules Cafe24ProductRule[] @relation("Cafe24ProductRuleProduct")
  cafe24AdCostSourceRules Cafe24ProductRule[] @relation("Cafe24AdCostSourceProduct")
  cafe24CouponRules Cafe24CouponRule[]
  currentAdsets   MetaAdset[]               @relation("CurrentAdsetProduct")

  @@map("products")
}

model ProductCostRule {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  salePriceKrw       Decimal  @map("sale_price_krw") @db.Decimal(14, 2)
  vatKrw             Decimal  @default(0) @map("vat_krw") @db.Decimal(14, 2)
  productCostKrw     Decimal  @default(0) @map("product_cost_krw") @db.Decimal(14, 2)
  shippingKrw        Decimal  @default(0) @map("shipping_krw") @db.Decimal(14, 2)
  extraCostKrw       Decimal  @default(0) @map("extra_cost_krw") @db.Decimal(14, 2)
  fxRateKrwPerUsd    Decimal  @map("fx_rate_krw_per_usd") @db.Decimal(12, 4)
  effectiveFrom      DateTime @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  product            Product  @relation(fields: [productId], references: [id])

  @@index([productId, effectiveFrom, effectiveTo])
  @@map("product_cost_rules")
}

model ExchangeRate {
  id              String                   @id @default(uuid()) @db.Uuid
  rateDate        DateTime                 @map("rate_date") @db.Date
  sourceDate      DateTime                 @map("source_date") @db.Date
  baseCurrency    String                   @default("USD") @map("base_currency") @db.VarChar(3)
  quoteCurrency   String                   @default("KRW") @map("quote_currency") @db.VarChar(3)
  rate            Decimal                  @db.Decimal(14, 6)
  provider        String                   @default("KOREA_EXIM") @db.VarChar(32)
  providerPayload Json?                    @map("provider_payload")
  fallbackType    ExchangeRateFallbackType @default(EXACT) @map("fallback_type")
  fetchedAt       DateTime                 @default(now()) @map("fetched_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@unique([rateDate, baseCurrency, quoteCurrency, provider])
  @@index([baseCurrency, quoteCurrency, rateDate])
  @@map("exchange_rates")
}

model ProductCpaRule {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  targetRatio   Decimal  @default(0.8000) @map("target_ratio") @db.Decimal(6, 4)
  watchRatio    Decimal  @default(1.1000) @map("watch_ratio") @db.Decimal(6, 4)
  stopRatio     Decimal  @default(1.2500) @map("stop_ratio") @db.Decimal(6, 4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId, effectiveFrom, effectiveTo])
  @@map("product_cpa_rules")
}

model MetaAdset {
  id                String                    @id @default(uuid()) @db.Uuid
  connectionId      String?                   @map("connection_id") @db.Uuid
  platform          String                    @default("META")
  externalAdsetId   String?                   @map("external_adset_id")
  campaignRefId     String?                   @map("campaign_ref_id") @db.Uuid
  adsetName         String                    @map("adset_name")
  adsetNameKey      String                    @map("adset_name_key")
  firstSeenOn       DateTime?                 @map("first_seen_on") @db.Date
  lastSeenOn        DateTime?                 @map("last_seen_on") @db.Date
  currentProductId  String?                   @map("current_product_id") @db.Uuid
  currentStage      AdStage                   @default(UNKNOWN) @map("current_stage")
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  campaign          MetaCampaign?             @relation(fields: [campaignRefId], references: [id])
  currentProduct    Product?                  @relation("CurrentAdsetProduct", fields: [currentProductId], references: [id])
  aliases           AdsetNameAlias[]
  productHistories  AdsetProductHistory[]
  stageHistories    AdsetStageHistory[]
  uploadRows        UploadRow[]
  dailyMetrics      MetaAdsetDailyMetric[]
  ads               MetaAd[]
  adDailyMetrics    MetaAdDailyMetric[]
  decisionLogs      DecisionLog[]
  changeLogs        ChangeLog[]
  creativePlacements CreativePlacement[]

  @@index([campaignRefId])
  @@index([platform, externalAdsetId])
  @@index([platform, adsetNameKey])
  @@map("meta_adsets")
}

model MetaCampaign {
  id                 String              @id @default(uuid()) @db.Uuid
  connectionId       String?             @map("connection_id") @db.Uuid
  platform           String              @default("META")
  externalCampaignId String              @map("meta_campaign_id")
  campaignName       String              @map("campaign_name")
  firstSeenOn        DateTime?           @map("first_seen_on") @db.Date
  lastSeenOn         DateTime?           @map("last_seen_on") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  adsets             MetaAdset[]
  ads                MetaAd[]
  adDailyMetrics     MetaAdDailyMetric[]
  creativePlacements CreativePlacement[]

  @@index([connectionId, platform, externalCampaignId])
  @@index([platform, campaignName])
  @@map("meta_campaigns")
}

model MetaAd {
  id                 String              @id @default(uuid()) @db.Uuid
  connectionId       String?             @map("connection_id") @db.Uuid
  platform           String              @default("META")
  campaignRefId      String              @map("campaign_ref_id") @db.Uuid
  metaAdsetRefId     String              @map("meta_adset_ref_id") @db.Uuid
  creativeId         String?             @map("creative_id") @db.Uuid
  metaCampaignId     String              @map("meta_campaign_id")
  metaAdsetId        String              @map("meta_adset_id")
  externalAdId       String?             @map("meta_ad_id")
  syntheticAdKey     String              @map("synthetic_ad_key")
  adIdentityKey      String              @map("ad_identity_key")
  adName             String              @map("ad_name")
  firstSeenOn        DateTime?           @map("first_seen_on") @db.Date
  lastSeenOn         DateTime?           @map("last_seen_on") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  campaign           MetaCampaign        @relation(fields: [campaignRefId], references: [id])
  metaAdset          MetaAdset           @relation(fields: [metaAdsetRefId], references: [id])
  creative           Creative?           @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  dailyMetrics       MetaAdDailyMetric[]
  placements         CreativePlacement[]

  @@index([connectionId, platform, metaCampaignId, metaAdsetId, adIdentityKey])
  @@index([platform, externalAdId])
  @@index([campaignRefId])
  @@index([metaAdsetRefId])
  @@index([creativeId])
  @@index([adName])
  @@map("meta_ads")
}

model Creative {
  id             String                @id @default(uuid()) @db.Uuid
  platform       String                @default("META")
  creativeKey    String                @map("creative_key")
  displayName    String                @map("display_name")
  productName    String?               @map("product_name")
  materialNo     String?               @map("material_no")
  firstSeenOn    DateTime?             @map("first_seen_on") @db.Date
  lastSeenOn     DateTime?             @map("last_seen_on") @db.Date
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  aliases        CreativeAlias[]
  placements     CreativePlacement[]
  changeLogs     CreativeChangeLog[]
  ads            MetaAd[]
  adDailyMetrics MetaAdDailyMetric[]

  @@unique([platform, creativeKey])
  @@index([displayName])
  @@map("creatives")
}

model CreativeAlias {
  id           String              @id @default(uuid()) @db.Uuid
  creativeId   String              @map("creative_id") @db.Uuid
  originalName String              @map("original_name")
  originalKey  String              @map("original_key")
  dateCode     String?             @map("date_code")
  setting      String?
  parseStatus  CreativeParseStatus @default(PARSED) @map("parse_status")
  firstSeenOn  DateTime?           @map("first_seen_on") @db.Date
  lastSeenOn   DateTime?           @map("last_seen_on") @db.Date
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  creative     Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([creativeId, originalKey])
  @@index([originalKey])
  @@map("creative_aliases")
}

model CreativePlacement {
  id             String        @id @default(uuid()) @db.Uuid
  connectionId   String?       @map("connection_id") @db.Uuid
  creativeId     String        @map("creative_id") @db.Uuid
  metaCampaignId String        @map("meta_campaign_id")
  metaAdsetId    String        @map("meta_adset_id")
  metaAdRefId    String?       @map("meta_ad_ref_id") @db.Uuid
  campaignRefId  String?       @map("campaign_ref_id") @db.Uuid
  metaAdsetRefId String?       @map("meta_adset_ref_id") @db.Uuid
  campaignName   String        @map("campaign_name")
  adsetName      String        @map("adset_name")
  originalAdName String        @map("original_ad_name")
  setting        String?
  firstSeenOn    DateTime?     @map("first_seen_on") @db.Date
  lastSeenOn     DateTime?     @map("last_seen_on") @db.Date
  lastStatus     String?       @map("last_status")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  creative       Creative      @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  metaAd         MetaAd?       @relation(fields: [metaAdRefId], references: [id])
  campaign       MetaCampaign? @relation(fields: [campaignRefId], references: [id])
  metaAdset      MetaAdset?    @relation(fields: [metaAdsetRefId], references: [id])
  connection     SourceConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([connectionId, creativeId])
  @@index([creativeId, lastSeenOn])
  @@index([metaCampaignId, metaAdsetId])
  @@map("creative_placements")
}

model CreativeChangeLog {
  id              String                @id @default(uuid()) @db.Uuid
  creativeId      String                @map("creative_id") @db.Uuid
  actionDate      DateTime              @default(now()) @map("action_date") @db.Date
  actionType      CreativeLogActionType @default(NOTE) @map("action_type")
  reason          String
  memo            String?
  relatedAdsetIds Json                  @default("[]") @map("related_adset_ids")
  nextCheckDate   DateTime?             @map("next_check_date") @db.Date
  createdBy       String?               @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  creative        Creative              @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  createdByUser   AppUser?              @relation("CreativeChangeLogCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([creativeId, actionDate])
  @@index([actionDate, actionType])
  @@index([createdBy])
  @@map("creative_change_logs")
}

model ProductChangeLog {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  actionDate  DateTime @default(now()) @map("action_date") @db.Date
  text        String   @map("log_text")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
