{
  "name": "meta-ads-performance-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.9.0 <25",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "local:assemble-release": "node deploy/local/assemble-local-release.mjs",
    "local:package-release": "node deploy/local/package-local-release.mjs",
    "local:verify-release": "node deploy/local/verify-local-release.mjs",
    "local:recovery-kit": "node deploy/local/recovery-kit.mjs",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @meta-ads-performance/api run start:dev",
    "dev:web": "npm --workspace @meta-ads-performance/web run dev",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "prisma:generate": "npm --workspace @meta-ads-performance/api run prisma:generate",
    "prisma:migrate": "npm --workspace @meta-ads-performance/api run prisma:migrate",
    "prisma:seed": "npm --workspace @meta-ads-performance/api run prisma:seed"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    },
    "body-parser": "2.3.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.7"
    },
    "nanoid": "3.3.18",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
