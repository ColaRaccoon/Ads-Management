# Copy to deploy/staging.env (gitignored) and inject secrets out-of-band.
APP_ENV=production
NODE_ENV=production
PORT=3200
API_INTERNAL_PORT=4200
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAMESPACE=staging
APP_ALLOWED_ORIGINS=https://staging.example.invalid
TRUST_PROXY_HOPS=1
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_ACCESS_MODE=rls
SUPABASE_STORAGE_BUCKET=meta-ads-security-step8-staging
SUPABASE_STORAGE_RETENTION_DAYS=30
SUPABASE_STORAGE_TIMEOUT_MS=15000
SUPABASE_STORAGE_MAX_OBJECT_BYTES=52428800
TEMP_STORAGE_BUDGET_BYTES=104857600
REPORT_DOWNLOAD_MAX_LIFETIME_MS=300000
SUPABASE_STORAGE_MIN_TOKEN_TTL_SECONDS=86400
SUPABASE_STORAGE_MAX_TOKEN_TTL_SECONDS=604800
SUPABASE_STORAGE_TOKEN_SUBJECT=staging-storage-app
SUPABASE_STORAGE_READINESS_KEY=health/readiness-sentinel
UPLOAD_STORAGE_DIR=./storage/staging/uploads
REPORT_STORAGE_DIR=./storage/staging/reports
DEPLOYMENT_ENVIRONMENT_ID=staging
RUNTIME_API_TARGET_ID=bundle-loopback-api
RUNTIME_DATABASE_ID=staging-primary
RUNTIME_STORAGE_ID=staging-private
READINESS_TIMEOUT_MS=1500
DATABASE_READINESS_TIMEOUT_MS=1000
JSON_BODY_LIMIT_BYTES=262144
URLENCODED_BODY_LIMIT_BYTES=65536

# Secret manager injection is required for DATABASE_URL, Supabase Auth keys,
# the scoped Storage JWT, session/CSRF rotation secrets, the stable authorization-version
# secret, and INTERNAL_PROBE_TOKEN.
