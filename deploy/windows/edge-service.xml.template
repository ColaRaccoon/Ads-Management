<service>
  <id>MetaAdsPerformanceEdge</id>
  <name>Meta Ads Performance HTTPS Edge</name>
  <description>Stable approval-gated LAN HTTPS 443 edge; independent from the mutable Web/API core.</description>
  <executable>__NODE_PATH__</executable>
  <arguments>__EDGE_LAUNCHER_PATH__</arguments>
  <workingdirectory>__RELEASE_ROOT__</workingdirectory>
  <env name="LOCAL_RUNTIME_CONFIG_PATH" value="__RUNTIME_CONFIG_PATH__" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
  <stoptimeout>30 sec</stoptimeout>
  <logpath>__LOG_PATH__</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
</service>
