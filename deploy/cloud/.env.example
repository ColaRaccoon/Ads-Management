# Shape reference only. Copy to deploy/cloud/.env.local, keep it out of Git,
# and replace every angle-bracket placeholder through an approved secret path.
NODE_ENV=production
APP_ENV=production
DEPLOYMENT_MODE=cloud_container
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
API_INTERNAL_PORT=4200
API_NODE_MAX_OLD_SPACE_MB=512
WEB_NODE_MAX_OLD_SPACE_MB=192
BUNDLE_SHUTDOWN_GRACE_MS=10000
PRISMA_CONNECTION_LIMIT=2
HEAVY_OPERATION_CONCURRENCY=1
HEAVY_OPERATION_RETRY_AFTER_SECONDS=5
REPORT_MAX_SOURCE_ROWS=25000

DATABASE_URL=<INJECT_POSTGRESQL_VERIFY_FULL_URL>
SUPABASE_DATABASE_PROJECT_REF=<INJECT_20_CHAR_PROJECT_REF>
SUPABASE_DATABASE_CONNECTION_MODE=<direct_OR_session_pooler>
SUPABASE_DATABASE_HOST=<INJECT_EXACT_DATABASE_HOST>
SUPABASE_DATABASE_RUNTIME_USER=<INJECT_RUNTIME_ROLE_WITHOUT_PROJECT_SUFFIX>
SUPABASE_DATABASE_NAME=<INJECT_EXACT_DATABASE_NAME>
SUPABASE_DATABASE_SCHEMA=<INJECT_EXACT_SCHEMA_NAME>
SUPABASE_URL=<INJECT_HTTPS_PROJECT_URL>
SUPABASE_PUBLISHABLE_KEY=<INJECT_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<INJECT_SERVER_SECRET_KEY>
SUPABASE_JWT_ISSUER=<INJECT_HTTPS_PROJECT_URL>/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_STORAGE_BUCKET=<INJECT_PRIVATE_BUCKET_ID>
SUPABASE_STORAGE_ACCESS_MODE=rls
SUPABASE_STORAGE_ACCESS_TOKEN=<INJECT_SCOPED_SHORT_LIVED_JWT>
SUPABASE_STORAGE_TOKEN_SUBJECT=<INJECT_STORAGE_SUBJECT>
SUPABASE_STORAGE_READINESS_KEY=health/readiness-sentinel
SUPABASE_STORAGE_RETENTION_DAYS=30
SUPABASE_STORAGE_TIMEOUT_MS=15000
SUPABASE_STORAGE_MAX_OBJECT_BYTES=52428800
SUPABASE_STORAGE_MIN_TOKEN_TTL_SECONDS=86400
SUPABASE_STORAGE_MAX_TOKEN_TTL_SECONDS=604800
TEMP_STORAGE_BUDGET_BYTES=104857600
REPORT_DOWNLOAD_MAX_LIFETIME_MS=300000

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAMESPACE=<INJECT_DEPLOYMENT_COOKIE_NAMESPACE>
APP_ALLOWED_ORIGINS=https://<INJECT_PUBLIC_HOSTNAME>
AUTH_INVITE_REDIRECT_ORIGIN=https://<INJECT_PUBLIC_HOSTNAME>
AUTH_SESSION_HANDLE_SECRET=<INJECT_INDEPENDENT_HIGH_ENTROPY_SECRET>
AUTH_AUTHORIZATION_VERSION_SECRET=<INJECT_INDEPENDENT_HIGH_ENTROPY_SECRET>
AUTH_CSRF_SECRET=<INJECT_INDEPENDENT_HIGH_ENTROPY_SECRET>
AUTH_CSRF_TTL_SECONDS=28800

TRUST_PROXY_HOPS=1
INTERNAL_PROBE_TOKEN=<INJECT_INDEPENDENT_HIGH_ENTROPY_SECRET>
READINESS_TIMEOUT_MS=1500
DATABASE_READINESS_TIMEOUT_MS=1000
JSON_BODY_LIMIT_BYTES=262144
URLENCODED_BODY_LIMIT_BYTES=65536
DEPLOYMENT_ENVIRONMENT_ID=local-cloud-rehearsal
RUNTIME_API_TARGET_ID=bundle-loopback-api
RUNTIME_DATABASE_ID=<INJECT_NON_SECRET_DATABASE_ID>
RUNTIME_STORAGE_ID=<INJECT_NON_SECRET_STORAGE_ID>
