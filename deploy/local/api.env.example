# Copy outside the repository during installation. Replace every <...> value.
APP_ENV=production
DEPLOYMENT_MODE=local_lan
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
PORT=<API_INTERNAL_PORT>
# Direct: db.<PROJECT_REF>.supabase.co:5432 and username <RUNTIME_DB_USER>.
# IPv4-only persistent hosts: exact Shared Pooler session endpoint on 5432 and username <RUNTIME_DB_USER>.<PROJECT_REF>.
# Percent-encode SSL_ROOT_CERT_ABSOLUTE_PATH. Transaction pooler port 6543 is not accepted.
DATABASE_URL=postgresql://<RUNTIME_OR_POOLER_USER>:<PASSWORD>@<EXACT_SUPABASE_DB_HOST>:5432/<DATABASE_NAME>?schema=<DATABASE_SCHEMA>&sslmode=verify-full&sslrootcert=<SSL_ROOT_CERT_ABSOLUTE_PATH>
SUPABASE_DATABASE_PROJECT_REF=<20_LOWERCASE_PROJECT_REF>
SUPABASE_DATABASE_CONNECTION_MODE=<direct_OR_session_pooler>
SUPABASE_DATABASE_HOST=<EXACT_SUPABASE_DB_HOST>
SUPABASE_DATABASE_RUNTIME_USER=<RUNTIME_DB_ROLE>
SUPABASE_DATABASE_CA_CERT_PATH=<SSL_ROOT_CERT_ABSOLUTE_PATH>
APP_DATA_ROOT=<ABSOLUTE_OS_APPLICATION_DATA_PATH>
UPLOAD_STORAGE_DIR=<APP_DATA_ROOT>/storage/uploads
REPORT_STORAGE_DIR=<APP_DATA_ROOT>/storage/reports
LOCAL_EDGE_PUBLIC_KEY_PATH=<APP_DATA_ROOT>/keys/edge-signing-public.pem
APP_ALLOWED_ORIGINS=https://<INSTALL_HOSTNAME>
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAMESPACE=<INSTALL_ID>
AUTH_SESSION_HANDLE_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_AUTHORIZATION_VERSION_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_CSRF_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_LOCAL_SESSION_TOKEN_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_LOCAL_SETUP_TOKEN_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_LOCAL_RATE_LIMIT_SECRET=<INDEPENDENT_RANDOM_SECRET>
AUTH_LOCAL_SESSION_IDLE_MINUTES=30
AUTH_LOCAL_SESSION_ABSOLUTE_HOURS=12
AUTH_LOCAL_SESSION_ROTATION_MINUTES=15
AUTH_LOCAL_SETUP_TOKEN_HOURS=24
AUTH_LOCAL_SCRYPT_CONCURRENCY=2
AUTH_LOCAL_SCRYPT_QUEUE_LIMIT=8
TRUST_PROXY_HOPS=0
INTERNAL_PROBE_TOKEN=<INDEPENDENT_RANDOM_SECRET>
DEPLOYMENT_ENVIRONMENT_ID=<INSTALL_ID>
RUNTIME_API_TARGET_ID=<INSTALL_ID>-api
RUNTIME_DATABASE_ID=<INSTALL_ID>-db
RUNTIME_STORAGE_ID=<INSTALL_ID>-storage
