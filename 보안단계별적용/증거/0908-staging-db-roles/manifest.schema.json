{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/r2a-staging-db-role-manifest.v1.schema.json",
  "title": "R2A staging DB role manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "version", "status", "operationalReady", "target", "release", "roles",
    "catalog", "files", "localRehearsal", "provider", "residuals"
  ],
  "properties": {
    "$schema": { "const": "./manifest.schema.json" },
    "version": { "const": "r2a-staging-db-role-manifest/v1" },
    "status": { "enum": ["LOCAL_PREPARED", "LOCAL_REHEARSAL_PASS", "PROVIDER_PHASE1_PASS_NOLOGIN", "PROVIDER_PHASE1_PASS_PHASE2_LOCAL_PREPARED", "PROVIDER_PHASE2_COMMIT_ACK_VERIFY_FAILED", "PROVIDER_PHASE2_CLASSIFIED_CREDENTIAL_OR_VERIFIER_MISMATCH", "PROVIDER_PHASE2_CREDENTIAL_RECOVERY_LOCAL_PREPARED"] },
    "operationalReady": { "const": false },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "projectRef", "projectName", "region", "plan", "adminDatabase", "applicationDatabase", "schema", "productionExcludedRef"],
      "properties": {
        "organizationId": { "const": "synohgzwspodxmfemoks" },
        "projectRef": { "const": "ehnfrrmbkvlsbpvqcvkr" },
        "projectName": { "const": "Meta Ads Performance Security Dev" },
        "region": { "const": "ap-northeast-2" },
        "plan": { "const": "Free" },
        "adminDatabase": { "const": "postgres" },
        "applicationDatabase": { "const": "meta_ads_staging" },
        "schema": { "const": "public" },
        "productionExcludedRef": { "const": "iygjmosbelbosfxidqxv" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "migrationImageIndex", "backupImageIndex", "migrationReleaseId", "migrationChainSha256"],
      "properties": {
        "gitSha": { "pattern": "^[a-f0-9]{40}$" },
        "migrationImageIndex": { "pattern": "^[a-f0-9]{64}$" },
        "backupImageIndex": { "pattern": "^[a-f0-9]{64}$" },
        "migrationReleaseId": { "pattern": "^[a-f0-9]{64}$" },
        "migrationChainSha256": { "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "roles": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "initialLogin", "inherit", "superuser", "createDatabase", "createRole", "replication", "bypassRls", "connectionLimit"],
        "properties": {
          "name": { "enum": ["meta_ads_stg_runtime", "meta_ads_stg_migration", "meta_ads_stg_backup"] },
          "initialLogin": { "const": false }, "inherit": { "const": false },
          "superuser": { "const": false }, "createDatabase": { "const": false },
          "createRole": { "const": false }, "replication": { "const": false },
          "bypassRls": { "const": false }, "connectionLimit": { "const": 2 }
        }
      }
    },
    "catalog": { "type": "object" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "localRehearsal": { "type": "object" },
    "provider": { "type": "object" },
    "residuals": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
